# Wire runs with zero config in DEMO mode: in-memory store, inline queue and a
# bundled sample of articles. Fill these in to run the real pipeline.

# --- The site the feeds describe ---------------------------------------------
SITE_URL=https://lumen.vitaliipopov.dev
SITE_TITLE=The Lumen Review
SITE_DESCRIPTION=Writing on craft, systems, and the work behind the screen.
SITE_LANGUAGE=en
# Public URL of this app (used for feed self-links and as the queue's target).
WIRE_URL=https://wire.vitaliipopov.dev

# --- Contentful (read-only Content Delivery API) ------------------------------
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_ACCESS_TOKEN=
# Content types whose events rebuild the feeds (comma-separated).
WIRE_CONTENT_TYPES=blogPost

# --- Webhook auth --------------------------------------------------------------
# Same value as the custom `x-webhook-secret` header on the Contentful webhook.
WEBHOOK_SECRET=

# --- Upstash Redis (dedup keys, feed store, event log) ------------------------
# Required on serverless hosts even in demo mode: memory doesn't survive between
# function instances. Vercel's Upstash integration sets KV_REST_API_URL/TOKEN,
# which Wire also accepts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash QStash (the queue between receiver and worker) -------------------
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
